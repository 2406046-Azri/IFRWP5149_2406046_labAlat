        </mxCell>
        <mxCell id="p11-cell-047" value="Use case selesai jika pengembalian tercatat&lt;br&gt;dengan tanggal kembali dan kondisi peralatan&lt;br&gt;serta status peminjaman menjadi Selesai; jika&lt;br&gt;status bukan Dipinjam, tidak ada pengembalian&lt;br&gt;baru yang tercatat dan status peminjaman tidak&lt;br&gt;berubah." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Arial;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1;fillColor=#FFFFFF;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="425" y="1098" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p11-cell-048" value="Keterangan: use case ini direalisasikan oleh collaboration LAB-CO02 Catat Pengembalian Peralatan, tanpa&lt;br&gt;langkah kegiatan sendiri. Keterlambatan dan denda belum dimodelkan pada pertemuan ini dan tidak&lt;br&gt;menimbulkan aturan tambahan pada tabel ini." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Arial;fontSize=12;fontColor=#000000;strokeColor=none;fillColor=none;fillColor=#FFFFFF;verticalAlign=top;" vertex="1" parent="1">
