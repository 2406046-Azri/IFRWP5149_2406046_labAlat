<mxfile host="Electron" pages="6">
  <diagram name="Tabel 5.16" id="3ByEydaP1V1F6DgOUUqA">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5; width: 25%;&quot;&gt;&lt;b&gt;Nama use case&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width: 75%;&quot;&gt;SIA-UC08 Input Nilai Mata Kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Aktor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Tujuan&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Nilai mata kuliah mahasiswa tersimpan untuk mahasiswa yang diampu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Deskripsi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen pengampu memilih mata kuliah dan mahasiswa, mengisi nilai, lalu menyimpan. Prasyarat: dosen adalah pengampu mata kuliah tersebut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Dosen membuka fungsi Input Nilai Mata Kuliah&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;2. Sistem menampilkan daftar mata kuliah yang diampu dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Dosen memilih mata kuliah&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4. Sistem menampilkan daftar mahasiswa peserta mata kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Dosen memilih mahasiswa dan mengisi nilai&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;6. Sistem memeriksa rentang nilai yang sah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7. Dosen menyimpan nilai&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;8. Sistem menyimpan nilai dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9. Nilai di luar rentang yang sah (cabang dari langkah 6)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;10. Sistem menolak penyimpanan dan menampilkan pesan nilai tidak sah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11. Dosen bukan pengampu mata kuliah yang dipilih (cabang dari langkah 2)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;12. Sistem menampilkan pesan dosen bukan pengampu dan input tidak dilanjutkan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #d5e8d4;&quot;&gt;&lt;b&gt;Skenario Akhir:&lt;/b&gt; Use case selesai jika nilai tersimpan; jika nilai di luar rentang sah atau dosen bukan pengampu, nilai tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="610" width="700" x="20" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="CGStYSTUvcXs-NkwHG6P" name="Tabel 5.17">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5; width: 25%;&quot;&gt;&lt;b&gt;Nama use case&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width: 75%;&quot;&gt;SIA-UC09 Lihat KHS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Aktor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Tujuan&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Mahasiswa dapat melihat Kartu Hasil Studi yang memuat nilai yang sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Deskripsi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Mahasiswa membuka fungsi Lihat KHS dan melihat nilai mata kuliah yang telah dipublikasikan pada semester yang dipilih&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Mahasiswa membuka fungsi Lihat KHS&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;2. Sistem menampilkan daftar semester&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Mahasiswa memilih semester&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4. Sistem menampilkan KHS yang hanya memuat nilai yang sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Belum ada nilai yang dipublikasikan pada semester yang dipilih (cabang dari langkah 4)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;6. Sistem menampilkan pesan belum ada nilai yang dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #d5e8d4;&quot;&gt;&lt;b&gt;Skenario Akhir:&lt;/b&gt; Use case selesai jika KHS dengan nilai terpublikasi ditampilkan; jika belum ada nilai terpublikasi, use case selesai dengan pesan tersebut.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="450" width="700" x="20" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="aviNgJhyzKIGlsz3m-60" name="Tabel 5.18">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5; width: 25%;&quot;&gt;&lt;b&gt;Nama use case&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width: 75%;&quot;&gt;SIA-UC10 Kelola Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Aktor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Admin Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Tujuan&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Data mahasiswa terkelola melalui satu fungsi pengelolaan bersama&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Deskripsi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Admin Akademik membuka fungsi pengelolaan data mahasiswa, memilih bentuk pengelolaan, dan menyimpan perubahan. Bentuk tambah, ubah, dan hapus dijabarkan pada tabel khususnya masing-masing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Admin Akademik membuka fungsi Kelola Data Mahasiswa&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;2. Sistem menampilkan daftar data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Admin Akademik memilih bentuk pengelolaan, yaitu tambah, ubah, atau hapus&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4. Sistem menampilkan formulir sesuai bentuk pengelolaan yang dipilih&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Admin Akademik mengisi atau mengonfirmasi data&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;6. Sistem memeriksa kelengkapan dan keabsahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7. Admin Akademik menyimpan perubahan&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;8. Sistem menyimpan perubahan dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9. Data tidak lengkap atau tidak sah (cabang dari langkah 6)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;10. Sistem menolak penyimpanan dan menampilkan pesan kesalahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #d5e8d4;&quot;&gt;&lt;b&gt;Skenario Akhir:&lt;/b&gt; Use case selesai jika perubahan data mahasiswa tersimpan; jika data tidak lengkap atau tidak sah, perubahan tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="600" width="700" x="20" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="QiRPzqd3KpJqdc0jroPz" name=" Tabel 5.19">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5; width: 25%;&quot;&gt;&lt;b&gt;Nama use case&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width: 75%;&quot;&gt;SIA-UC11 Tambah Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Aktor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen Wali&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Tujuan&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Data mahasiswa baru tersimpan sebagai bentuk khusus dari pengelolaan data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Deskripsi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen Wali mengisi data mahasiswa baru dan menyimpan data tersebut; langkah bersama mengikuti Tabel skenario SIA-UC10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Dosen Wali membuka fungsi Tambah Data Mahasiswa&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;2. Sistem menampilkan formulir data mahasiswa baru&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Dosen Wali mengisi data mahasiswa baru&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4. Sistem memeriksa kelengkapan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Dosen Wali menyimpan data&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;6. Sistem menyimpan data mahasiswa baru dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7. Data tidak lengkap (cabang dari langkah 4)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;8. Sistem menolak penyimpanan dan meminta Dosen Wali melengkapi data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #d5e8d4;&quot;&gt;&lt;b&gt;Skenario Akhir:&lt;/b&gt; Use case selesai jika data mahasiswa baru tersimpan; jika data tidak lengkap, data tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="490" width="700" x="20" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="UpRHMggQHkI1h-ywxoiN" name="Tabel 5.20">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5; width: 25%;&quot;&gt;&lt;b&gt;Nama use case&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width: 75%;&quot;&gt;SIA-UC12 Ubah Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Aktor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen Wali&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Tujuan&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Data mahasiswa berubah sebagai bentuk khusus dari pengelolaan data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Deskripsi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen Wali memilih data mahasiswa, mengubah datanya, dan menyimpan perubahan; langkah bersama mengikuti Tabel skenario SIA-UC10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Dosen Wali memilih data mahasiswa yang akan diubah&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;2. Sistem menampilkan data mahasiswa saat ini&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Dosen Wali mengubah data mahasiswa&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4. Sistem memeriksa perubahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Dosen Wali menyimpan perubahan&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;6. Sistem menyimpan data yang diubah dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7. Data mahasiswa tidak ditemukan (cabang dari langkah 2)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;8. Sistem menampilkan pesan data mahasiswa tidak ditemukan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #d5e8d4;&quot;&gt;&lt;b&gt;Skenario Akhir:&lt;/b&gt; Use case selesai jika perubahan data mahasiswa tersimpan; jika data tidak ditemukan, perubahan tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="500" width="700" x="20" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="7ZBP0oNtLfmTU75C8eHD" name="Tabel 5.21">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5; width: 25%;&quot;&gt;&lt;b&gt;Nama use case&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width: 75%;&quot;&gt;SIA-UC13 Hapus Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Aktor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen Wali&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Tujuan&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Data mahasiswa terhapus sebagai bentuk khusus dari pengelolaan data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;b&gt;Deskripsi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dosen Wali memilih data mahasiswa, mengonfirmasi penghapusan, dan sistem menghapus data tersebut; langkah bersama mengikuti Tabel skenario SIA-UC10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background-color: #e1e1e1; text-align: center;&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Dosen Wali memilih data mahasiswa yang akan dihapus&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;2. Sistem memeriksa mahasiswa tidak memiliki data akademik aktif&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Dosen Wali mengonfirmasi penghapusan&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4. Sistem menghapus data mahasiswa dan menampilkan konfirmasi penghapusan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #dae8fc; font-weight: bold;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Mahasiswa memiliki data akademik aktif (cabang dari langkah 2)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;6. Sistem menolak penghapusan dan menampilkan pesan mahasiswa masih memiliki data akademik aktif&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background-color: #d5e8d4;&quot;&gt;&lt;b&gt;Skenario Akhir:&lt;/b&gt; Use case selesai jika data mahasiswa terhapus; jika mahasiswa memiliki data akademik aktif, data tidak terhapus.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="470" width="700" x="20" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
